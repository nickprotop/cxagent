<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A LIBRARY, NOT AN EXE. A plugin is loaded into a host that already exists; the other
         examples here are programs that build an agent, and this one is the thing an agent loads. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CalculatorPlugin</RootNamespace>
    <AssemblyName>calculator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE CONTRACT, NOT THE RUNTIME. Implementing IPlugin needs seven types; referencing
         cxagent.Core to get them pulled in Sqlite, AngleSharp and the LLM providers as well.
         Private="false" stays: the host loads this assembly and the plugin must bind to the host's
         copy, because Assembly.LoadFrom gives a shipped duplicate a distinct type identity and the
         host's `is IPlugin` check would fail. -->
    <ProjectReference Include="../../../cxagent.Plugins.Abstractions/cxagent.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE SIDECAR SHIPS BESIDE THE DLL. ManagedPluginLoader reads it before Load() runs and
         refuses a mismatch against what Load() returns — see README.md, "The sidecar". -->
    <None Update="calculator.plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
