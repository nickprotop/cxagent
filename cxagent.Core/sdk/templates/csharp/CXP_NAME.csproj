<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CXP_NAME</AssemblyName>
    <RootNamespace>CXP_ROOT_NAMESPACE</RootNamespace>
    <!-- What `cxagent plugin pack` writes into the catalog entry; pack's options override them. -->
    <Description>CXP_NAME — describe what it does in one sentence.</Description>
    <Authors></Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- ExcludeAssets="runtime": cxagent already has the contract loaded, and the plugin binds to it. -->
    <PackageReference Include="CxAgent.Plugins.Abstractions" Version="CXP_ABSTRACTIONS_VERSION" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Update="CXP_NAME.plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
