<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CXP_NAME</AssemblyName>
    <RootNamespace>CXP_ROOT_NAMESPACE</RootNamespace>
    <!-- A LIBRARY LEAVES ITS PACKAGES IN THE NUGET CACHE, and cxagent loads a plugin from its own
         folder: without this, the first package you add builds, then fails to load. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- What `cxagent plugin pack` writes into the catalog entry; pack's options and info file
         override them. Left empty on purpose: pack writes a placeholder for an empty one, and
         verify refuses it until you say what the plugin does. -->
    <Description></Description>
    <Authors></Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- ExcludeAssets="runtime": cxagent already has the contract loaded, and the plugin binds to it. -->
    <PackageReference Include="CxAgent.Plugins.Abstractions" Version="CXP_ABSTRACTIONS_VERSION" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Update="CXP_NAME.plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
