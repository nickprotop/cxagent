<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>CxAgent.Plugins.Testing</AssemblyName>
    <RootNamespace>CxAgent.Plugins.Testing</RootNamespace>
    <PackageId>CxAgent.Plugins.Testing</PackageId>
    <Authors>Nikolaos Protopapas</Authors>
    <Description>Check and call a cxagent plugin from a test: the same loaders, gate and lifecycle a session uses, with no session.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../cxagent.Core.csproj" />
  </ItemGroup>

  <!-- THE TEST SEAMS STAY OFF THE PUBLISHED SURFACE: cxagent.Tests reaches them as internals, and
       an author referencing the package sees only what it is for. -->
  <ItemGroup>
    <InternalsVisibleTo Include="cxagent.Tests" />
  </ItemGroup>

  <!-- THE PLUGIN HOST TRAVELS WITH THE PACKAGE, so a C# test loads a native plugin without a cxagent
       installed. Built from the same tag as this package, it is the host AbiHostProcess's version
       check accepts; a host from elsewhere would be refused. The reference orders the build — nothing
       here links against the host — and build/CxAgent.Plugins.Testing.targets copies the packed files
       beside the consumer's test.

       WITHOUT THE RELEASE'S PUBLISH SETTINGS: the release publishes cxagent for one RID, self-contained
       and single-file, and passes those properties to every reference, and an Exe given SelfContained or
       PublishSingleFile but no RID takes the build machine's own, which a restore for <rid> never
       produced. The package needs the portable host from bin/<config>/<tfm>/ in any case.

       ONLY TOP-LEVEL *.dll AND *.json, NOT runtimes/: the host's native assets (e_sqlite3 and the
       rest) come with Core's dependencies, and the host never opens Sqlite. A host change that does
       would fail only in a consumer — pack runtimes/ too before making one. -->
  <ItemGroup>
    <ProjectReference Include="../../../cxagent.PluginHost/cxagent.PluginHost.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="SelfContained;RuntimeIdentifier;PublishSingleFile" />
    <None Include="build/CxAgent.Plugins.Testing.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- THE HOST'S FILES ARE GATHERED WHEN PACK RUNS, AFTER THE BUILD — not by a glob in an ItemGroup,
       which is evaluated before the reference has built the host and so packs nothing on a clean
       tree, or an older host on a stale one. A pack that still finds no host is refused: a package
       without one fails every native test of everyone who installs it. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackPluginHost</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackPluginHost">
    <PropertyGroup>
      <PluginHostOut>$(MSBuildThisFileDirectory)../../../cxagent.PluginHost/bin/$(Configuration)/$(TargetFramework)/</PluginHostOut>
    </PropertyGroup>
    <Error Condition="!Exists('$(PluginHostOut)cxagent-plugin-host.dll')"
           Text="No plugin host at $(PluginHostOut) to pack; build cxagent.PluginHost in $(Configuration) first." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(PluginHostOut)*.dll;$(PluginHostOut)*.json" PackagePath="build/plugin-host" />
    </ItemGroup>
  </Target>
</Project>
