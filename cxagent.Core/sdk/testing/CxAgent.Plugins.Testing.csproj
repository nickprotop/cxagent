<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>CxAgent.Plugins.Testing</AssemblyName>
    <RootNamespace>CxAgent.Plugins.Testing</RootNamespace>
    <PackageId>CxAgent.Plugins.Testing</PackageId>
    <Authors>Nikolaos Protopapas</Authors>
    <Description>Check and call a cxagent plugin from a test: the same loaders, gate and lifecycle a session uses, with no session.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../cxagent.Core.csproj" />
  </ItemGroup>
</Project>
