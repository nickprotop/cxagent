<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- THREE TARGETS, BECAUSE net8.0 IS WHERE MOST PRODUCTION .NET LIVES. It is the current LTS,
         supported into November 2026; net10 is months old. A library that only restores into net10
         is unavailable to most of the people who would use it, which is a bigger adoption gap than
         any missing feature — an evaluator who cannot `dotnet add package` never reaches the API.

         FREE, AND VERIFIED BEFORE BEING CLAIMED: three assemblies, 0 warnings, 2,053 tests passing,
         with NO source changes. Nothing here needed net10. The two features that looked
         version-sensitive are not — collection expressions are C# 12, and SearchValues.Create(string)
         (ReadOnlyCommands.cs) is a net8 API; only its generic overloads are net9.

         THE APP DOES NOT FOLLOW. cxagent ships as self-contained binaries nobody references, so
         multi-targeting it would triple six platform builds in the release workflow to serve nobody.

         THIS IS NOW A PROMISE. Adopting a net9+ API later means dropping net8, which consumers
         experience as a breaking change — and any future PackageReference must be checked for net8
         support before it is added. Doing it now, while no code needs anything newer, is what makes
         it cost nothing. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CxAgent.Core</RootNamespace>
    <AssemblyName>CxAgent.Core</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CxAgent.Core</PackageId>

    <!-- A LOCAL-BUILD PLACEHOLDER. The release workflow passes -p:Version from the git tag, so what
         ships is always the tag and never this number. It stays 0.0.0 deliberately: a plausible
         version here would be indistinguishable from a real one in a local `dotnet pack`, and the
         one thing worse than an unversioned package is a wrongly versioned one.
         The library and the app share a tag — v0.3.5 produces both. -->
    <Version>0.0.0</Version>

    <!-- FROZEN, AND IT IS THE PLUGIN CONTRACT THAT DEPENDS ON IT. A managed plugin compiles against
         this assembly and binds to the AssemblyVersion it saw; .NET then resolves that by EXACT
         match. Letting <Version> set it too meant every release minted a new binding identity, so a
         plugin built for 0.9.5 was refused by 0.9.6 with "Could not load file or assembly" — before
         PluginContract, the check that exists to answer compatibility, was ever read. Every release
         broke every plugin, and said nothing useful about why.

         An ABI plugin never had this problem: it is a .so with no reference to us, so the contract
         integer is its only agreement. Freezing this gives a managed plugin the same guarantee.

         FileVersion and InformationalVersion still carry the real release, so `dotnet pack`, NuGet
         and a crash dump all report the tag. Only the loader's identity is pinned.

         THIS NUMBER NEVER CHANGES. Compatibility is PluginContract.Version's job — an integer the
         host checks and can explain. Bumping this would silently refuse every plugin again. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <Authors>Nikolaos Protopapas</Authors>
    <Company>Nikolaos Protopapas</Company>
    <Product>CxAgent</Product>
    <Copyright>Copyright (c) 2026 Nikolaos Protopapas</Copyright>

    <Title>CxAgent.Core — embeddable coding-agent sessions</Title>
    <Description>The sessions, agents and turn loop behind cxagent, usable without a terminal. A conversation, the agent running it, tool execution, sub-agent delegation, permissions, MCP and resumable stores — you supply where text goes. No UI dependency.</Description>
    <PackageTags>ai;agent;llm;coding-agent;mcp;anthropic;openai;ollama;tools;sub-agents</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nickprotop/cxagent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nickprotop/cxagent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SOURCE LINK, so a consumer stepping into this package lands on the real line rather than
         decompiled approximations. Embedded rather than a separate .snupkg: one artifact to publish,
         and the symbols cannot go missing from a mirror that only carried the .nupkg. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>

    <!-- THE XML DOCS SHIP. Every public member here carries the reasoning behind it, and stripping
         that at the package boundary would leave a consumer with signatures and no WHY — which is
         most of what this codebase's comments are for. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (undocumented public member) STAYS SUPPRESSED, and CS1573 no longer is.
         The two are not the same problem. CS1573 fires where a declaration documents SOME of its
         parameters and not others — a half-finished doc, and a real one: StatsTotals explained the
         two params about cache COVERAGE and said nothing about the eight around them, so a consumer
         reading the tooltip saw the subtle half of a record and had to guess the rest. All 186 of
         those tags are now written; the warning is on, so the next one is caught at the compiler.
         CS1591 is different. It fires on members whose NAME is the documentation —
         WorkerTool.ReadFile, WorkerTool.WriteFile, AskUserTool.ToolName. A <summary>Read a file.</summary>
         there is ceremony that buries the reasoning the surrounding docs actually carry. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />

    <!-- THE DOCS SHIP WITH THE PACKAGE, because the README links to them with relative paths and a
         reader on nuget.org would otherwise follow four dead links. Packing them is what makes
         `](docs/api.md)` mean the same thing in the repository and in the package. -->
    <None Include="docs/*.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

  <!-- THE EXAMPLES ARE CONSUMERS, NOT SOURCES. They live under this directory so the package's own
       README can point at them without leaving the library's tree, and the SDK's default glob would
       otherwise compile them INTO the library — which fails immediately (they reference Spectre.Console,
       which Core must never see) and would ship them if it did not.
       Excluded rather than moved out because discoverability from the package won the trade; this
       one line is what it costs. -->
  <ItemGroup>
    <Compile Remove="examples/**" />
    <None Remove="examples/**" />
    <EmbeddedResource Remove="examples/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The resume buffer and the usage archive. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />

    <!-- web_fetch parses HTML with AngleSharp rather than regex over a document.
         REFERENCED HERE NOW, and the old reasoning for not doing so has inverted. It used to arrive
         transitively through SharpConsoleUI, so pinning it from this side only created a downgrade
         to resolve whenever the UI package moved ahead. This project never sees SharpConsoleUI, so
         there is no transitive path to inherit and no conflict to resolve — the app gets AngleSharp
         from both and NuGet unifies upward, which is the ordinary case.
         The cost is real and worth naming: this pin no longer follows SharpConsoleUI automatically,
         so a bump there needs one here. That is what a library pinning what it tested against
         means. -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
  </ItemGroup>

</Project>
