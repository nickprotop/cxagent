bin/
obj/
*.user
.vs/
.idea/
.claude/
CLAUDE.md
docs/superpowers/
.superpowers/

# Local config and secrets never belong here. Real configuration lives in
# ~/.config/cxagent/config.json (XDG), outside the repo — these patterns are a
# backstop for a stray copy made while debugging.
config.json
secrets.json
appsettings.*.json
*.env
.env

publish/
.worktrees/

# Editor workspace state. lazydotide writes .lazydotide.workspace beside whatever
# project it has open — per-developer window layout and open tabs, which is
# exactly the kind of file that produces a diff for everyone the moment one
# person opens the repo in it.
.lazydotide.workspace

# Skills are per-developer, not per-repository. A SKILL.md here is discovered and
# loaded by every cxagent session run from this folder, so committing one imposes
# it on everyone who clones — including whatever house rules or tool preferences
# it encodes. Keep them local; a skill that genuinely belongs to the project can
# be argued for on its own merits.
.agents/
.cxagent/

# CLAUDE.md is a symlink to CXAGENT.md — the same conventions under the name Claude Code
# looks for. Ignored rather than committed: the link is a local convenience, and a checked-in
# symlink breaks on any platform or checkout that does not support one.
CLAUDE.md

# Plans written by the planner agent type. Working notes for a builder to carry
# out, not project documentation — a plan that outlives its task is clutter, and
# one worth keeping belongs in docs/ under a name a human chose.
plans/

# Working design notes — internal, not part of the published repo.
# The reasoning behind decisions, kept where the person making the next one can read it.
.design/
