<Project Sdk="Microsoft.NET.Sdk">

  <!-- A MANAGED PLUGIN IS A PLAIN LIBRARY ManagedPluginLoader loads by path (Assembly.LoadFrom),
       not an executable — the same shape csharp-lsp takes. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>repo-map</AssemblyName>
    <RootNamespace>CxAgent.Plugins.RepoMap</RootNamespace>
  </PropertyGroup>

  <!-- TREE-SITTER'S NATIVES, ONE PLATFORM'S AT A TIME. The package carries every platform's (about
       600 MB), so it is downloaded, never referenced: a reference would copy all of them into every
       build. A normal build takes this machine's platform, so tests and drives run against real
       natives; the release builds once per platform with -p:TreeSitterRid=<rid>. -->
  <PropertyGroup>
    <TreeSitterVersion>1.3.0</TreeSitterVersion>
    <TreeSitterRid Condition="'$(TreeSitterRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</TreeSitterRid>
    <TreeSitterNatives>$(NuGetPackageRoot)treesitter.dotnet/$(TreeSitterVersion)/runtimes/$(TreeSitterRid)/native/</TreeSitterNatives>
    <!-- The vendored binding documents its public API for its own package; this plugin does not ship one. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="TreeSitter.DotNet" Version="[$(TreeSitterVersion)]" />

    <!-- THE CORE LIBRARY AND THE 14 GRAMMARS THIS PLUGIN READS, by name: the package has 28, and the
         other 14 are 30 MB nobody asked for. "lib" on Linux and macOS, none on Windows, hence the
         leading *. "*tree-sitter-c.*" does not match tree-sitter-c-sharp: the dot is literal. -->
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-c.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-cpp.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-c-sharp.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-java.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-scala.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-javascript.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-typescript.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-tsx.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-go.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-rust.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-python.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-ruby.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-php.*" />
    <TreeSitterNative Include="$(TreeSitterNatives)*tree-sitter-bash.*" />

    <!-- AS None WITH A LINK, so they also land in a referencing project's output — the tests load
         the real libraries from their own bin folder. -->
    <None Include="@(TreeSitterNative)" Link="runtimes/$(TreeSitterRid)/native/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- LOUD, NOT A MAP THAT QUIETLY READS EVERYTHING AS TEXT. A wrong RID or a package that changed
       its layout would otherwise build a plugin with no parser in it, and only the header would say. -->
  <Target Name="RequireTreeSitterNatives" BeforeTargets="BeforeBuild">
    <Error Condition="'@(TreeSitterNative->Count())' != '15'"
           Text="Expected 15 Tree-sitter libraries for '$(TreeSitterRid)' in '$(TreeSitterNatives)', found @(TreeSitterNative->Count())." />
  </Target>

  <!-- THE TEST PROJECT IS NESTED UNDER tests/, SO ITS SOURCE MUST BE EXCLUDED HERE. An SDK project
       globs **/*.cs beneath itself, which would otherwise sweep the tests into this
       library too — the same duplicate-compile hazard cxagent.Tests.csproj calls out for its own
       nested fixtures. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE CONTRACT, NOT THE RUNTIME. Private="false" stays: the host loads this assembly and the
         plugin must bind to the host's copy, because Assembly.LoadFrom gives a shipped duplicate a
         distinct type identity and the host's `is IPlugin` check would fail. -->
    <ProjectReference Include="../../cxagent.Plugins.Abstractions/cxagent.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="repo-map.plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
