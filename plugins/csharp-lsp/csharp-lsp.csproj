<Project Sdk="Microsoft.NET.Sdk">

  <!-- A MANAGED PLUGIN IS A PLAIN LIBRARY ManagedPluginLoader LOADS BY PATH (Assembly.LoadFrom),
       not an executable — see cxagent.Tests.PluginFixture.csproj for the same shape. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>csharp-lsp</AssemblyName>
    <RootNamespace>CxAgent.Plugins.Lsp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE CONTRACT, NOT THE RUNTIME. Implementing IPlugin needs seven types; referencing
         cxagent.Core to get them pulled in Sqlite, AngleSharp and the LLM providers as well.
         Private="false" stays: the host loads this assembly and the plugin must bind to the host's
         copy, because Assembly.LoadFrom gives a shipped duplicate a distinct type identity and the
         host's `is IPlugin` check would fail. -->
    <ProjectReference Include="../../cxagent.Plugins.Abstractions/cxagent.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sidecar sits beside the built DLL, exactly like the test fixtures' PreserveNewest copy —
         PluginDiscovery reads assemblyPath with ".plugin.json" swapped in for the extension. -->
    <None Include="csharp-lsp.plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
