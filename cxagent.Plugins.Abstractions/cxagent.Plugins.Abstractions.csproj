<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 is off under the same policy as CxAgent.Core: members whose name is the
         documentation (JobResult.ExitCode, JobLogLevel.Error) need no ceremony. CS1574 is off for
         a reason specific to this assembly: the contract's docs explain themselves by NAMING
         runtime types — ManagedPluginLoader, PermissionRequest, ToolOutcome — that live on the
         other side of the boundary this assembly exists to draw, so those crefs cannot resolve
         here by design rather than by typo. -->
    <NoWarn>$(NoWarn);CS1591;CS1574</NoWarn>
    <AssemblyName>CxAgent.Plugins.Abstractions</AssemblyName>
    <RootNamespace>CxAgent.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CxAgent.Plugins.Abstractions</PackageId>

    <!-- THE PACKAGE VERSION IS THE CONTRACT NUMBER. A plugin author reading
         Version="3.0.0" is reading the same fact their sidecar declares as
         "pluginContract": 3, so the two compatibility signals are one signal said twice.
         KEEP THIS MAJOR IN STEP WITH PluginContract.Version: a placeholder that disagrees with the
         constant makes a liar of the sentence above, and it is the sentence a plugin author trusts.

         PackageVersion, NOT Version. The release packs with -p:Version from the app's tag, and a
         global property reaches every project in the build, this one included: as <Version> this
         would be packed as the app's number, and CxAgent.Core would depend on a contract package
         of that number which is never published. A tag does not set PackageVersion, so the
         contract keeps its own number and Core's dependency names it.

         RAISED BY HAND, never by a release. Each version is pushed once and every later release
         skips it as a duplicate, so a compatible change to this assembly ships only when this number
         moves — a minor for an addition, the next major with PluginContract.Version. -->
    <PackageVersion>4.0.0</PackageVersion>

    <!-- THE PUBLISHED CONTRACT THIS ONE MUST STAY COMPATIBLE WITH. Package validation compares this
         build's public API with that version on nuget.org and fails the pack on a break — a change
         that compiles can still break every plugin already built (a new positional parameter on
         PluginGate loads fine and throws MissingMethodException on first use). EMPTY FOR A NEW
         MAJOR, which breaks on purpose and has nothing published to compare with yet; set it to the
         major's first version once that is on nuget.org, and raise it with each later one. -->
    <ContractBaseline></ContractBaseline>
    <EnablePackageValidation Condition="'$(ContractBaseline)' != ''">true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(ContractBaseline)' != ''">$(ContractBaseline)</PackageValidationBaselineVersion>

    <!-- FROZEN, AND NEVER BUMPED — not even at a contract change. This is the identity .NET
         resolves by exact match, so moving it would refuse an old plugin at LOAD, before
         PluginContract.Version — the check that exists to answer compatibility and can say why in
         words — is ever read. One gate, and it is the one that explains itself. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <Authors>Nikolaos Protopapas</Authors>
    <Description>The contract a cxagent plugin implements: IPlugin, its manifest, and the job types a tool exchanges.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE HOST STAMPS WHAT A PLUGIN MUST NOT: JobResult's PermissionDenied, DecidedBy, LogFile and
         Duration are internal init, and these are the first-party assemblies that set them. -->
    <InternalsVisibleTo Include="CxAgent.Core" />
    <InternalsVisibleTo Include="cxagent" />
    <InternalsVisibleTo Include="cxagent.Tests" />
  </ItemGroup>

</Project>
