<Project Sdk="Microsoft.NET.Sdk">

  <!-- A SECOND PROCESS THAT HOLDS A SESSION LOCK AND THEN DIES. SessionLockTests kills it to prove the
       kernel releases the lock with the holder; a lock held by the test process itself cannot show that,
       because the test process never dies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../cxagent.Core/cxagent.Core.csproj" />
  </ItemGroup>

</Project>
