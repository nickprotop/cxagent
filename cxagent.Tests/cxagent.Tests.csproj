<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- xUnit1031 flags .Result/.Wait() as deadlock-prone. Here it is the CLAIM: these tests assert
         Completion.IsCompleted first, and reading .Result synchronously is what proves the prompt
         resolved WITHOUT a further await. Rewriting them as awaits would pin something weaker. -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../cxagent/cxagent.csproj" />
    <ProjectReference Include="../cxagent.Core/cxagent.Core.csproj" />

    <!-- REAL DLLS ON DISK FOR ManagedPluginLoaderTests. A ProjectReference here, rather than a
         second copy of these types inside this project, is what makes Assembly.LoadFrom load a
         DIFFERENT assembly than cxagent.Tests.dll itself — the loader is only exercised honestly
         when the plugin it loads is not the process's own entry assembly. Each fixture is its OWN
         project: an assembly's IPlugin count is a whole-assembly property (GetTypes scans
         everything in it), so "exactly one" and "more than one" each need a dedicated assembly
         rather than one shared fixture DLL with several plugin classes in it. -->
    <ProjectReference Include="../cxagent.Tests.PluginFixture/cxagent.Tests.PluginFixture.csproj" />
    <ProjectReference Include="../cxagent.Tests.PluginFixture.Mismatched/cxagent.Tests.PluginFixture.Mismatched.csproj" />
    <ProjectReference Include="../cxagent.Tests.PluginFixture.Throwing/cxagent.Tests.PluginFixture.Throwing.csproj" />
    <ProjectReference Include="../cxagent.Tests.PluginFixture.Empty/cxagent.Tests.PluginFixture.Empty.csproj" />
    <ProjectReference Include="../cxagent.Tests.PluginFixture.Ambiguous/cxagent.Tests.PluginFixture.Ambiguous.csproj" />

    <!-- THE REAL LSP PLUGIN, not a fixture — CxagentLspPluginTests exercises its own manifest and
         position math directly; only the end-to-end tests against a real server (Skip'd, see
         HeadlessSessionTests.AgainstLocalLlamaCpp for the same pattern) need a language server on
         this machine. -->
    <ProjectReference Include="../plugins/csharp-lsp/csharp-lsp.csproj" />

    <!-- THE REAL HOST PROCESS, launched as a subprocess by AbiPluginHostTests exactly as Task 9c's
         shim will launch it — a ProjectReference here, not a copy, so the tests exercise the built
         executable rather than a description of it. -->
    <ProjectReference Include="../cxagent.PluginHost/cxagent.PluginHost.csproj" />
  </ItemGroup>

  <!-- THE ABI REWRITE OF THE LSP PLUGIN — NOT A ProjectReference, because it is a NativeAOT native
       library, not a managed assembly this project could reference or load in-process; see
       csharp-lsp-abi.csproj's own comment. `dotnet publish -r linux-x64` is what runs the
       ILC pipeline that turns its [UnmanagedCallersOnly] exports into real `cxagent_plugin_*`
       symbols — an ordinary `dotnet build` of that project produces a managed .dll with none of
       them, so this target publishes it explicitly, the same reason AbiFixtures/build.sh compiles
       its own fixture rather than trusting a build to have done it. Condition guards non-Linux the
       same way BuildAbiFixtures does; a NativeAOT publish needs a native toolchain (cc/clang) this
       repo's own gcc check already establishes is present when Linux ABI tests run at all. -->
  <Target Name="PublishAbiLspPlugin" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../plugins/csharp-lsp-abi/csharp-lsp-abi.csproj&quot; -c Release -r linux-x64 --self-contained -p:PublishAot=true -p:NativeLib=Shared -v quiet" />
    <!-- THE SIDECAR, COPIED BESIDE THE PUBLISHED .so — AbiPluginLoader.Load resolves it from the
         LIBRARY path with ".plugin.json" swapped in for the extension (same rule as every other
         sidecar in this project), and `dotnet publish`'s own None/CopyToOutputDirectory only
         reaches the project's ordinary $(OutDir), never the RID-specific publish/ subfolder this
         target's -r linux-x64 produces. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../plugins/csharp-lsp-abi/csharp-lsp-abi.plugin.json"
          DestinationFolder="$(MSBuildProjectDirectory)/../plugins/csharp-lsp-abi/bin/Release/net10.0/linux-x64/publish/" />
  </Target>

  <!-- NATIVE ABI FIXTURES, BUILT BY A SHELL SCRIPT BECAUSE MSBUILD HAS NO C COMPILER TASK.
       AfterTargets="Build" (not BeforeBuild) so the fixtures land in $(OutDir) after MSBuild has
       created it — building them earlier would have nowhere guaranteed to copy them onto, and
       CopyToOutputDirectory cannot ferry a file this project's own compile step didn't produce.
       Condition guards non-Linux and CI images with no C toolchain: AbiFixtures/build.sh already
       skips cleanly and exits 0 when no compiler is found, so this target degrades to a no-op
       rather than failing dotnet build entirely for a fixture only Linux-hosted ABI tests need. -->
  <Target Name="BuildAbiFixtures" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/AbiFixtures/build.sh&quot; &quot;$(OutDir)&quot;" />
  </Target>

  <ItemGroup>
    <!-- SIDECARS, COPIED NEXT TO THE FIXTURE DLLS. ManagedPluginLoader looks for
         '<plugin>.plugin.json' beside '<plugin>.dll' at the OUTPUT path, not the source path, so
         these must land in the test binaries' own output directory, named after their DLL's own
         stem, to be found at all. -->
    <None Include="PluginFixtures/WellFormedPlugin.plugin.json" CopyToOutputDirectory="PreserveNewest"
          TargetPath="cxagent.Tests.PluginFixture.plugin.json" />
    <None Include="PluginFixtures/MismatchedPlugin.plugin.json" CopyToOutputDirectory="PreserveNewest"
          TargetPath="cxagent.Tests.PluginFixture.Mismatched.plugin.json" />
    <None Include="PluginFixtures/ThrowingPlugin.plugin.json" CopyToOutputDirectory="PreserveNewest"
          TargetPath="cxagent.Tests.PluginFixture.Throwing.plugin.json" />

    <!-- BESIDE fixture-wellformed.so AT THE OUTPUT ROOT, not under AbiPluginFixtures/ — AbiPluginLoader
         resolves a sidecar from the LIBRARY path with ".plugin.json" swapped in for the extension,
         exactly like ManagedPluginLoader does for a managed assembly, so this must land at the same
         path the native fixture itself does (AbiFixtures/build.sh's own OUT_DIR). -->
    <None Include="AbiPluginFixtures/fixture-wellformed.plugin.json" CopyToOutputDirectory="PreserveNewest"
          TargetPath="fixture-wellformed.plugin.json" />
  </ItemGroup>

</Project>
