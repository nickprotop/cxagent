<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CxAgent</RootNamespace>
    <AssemblyName>cxagent</AssemblyName>
  </PropertyGroup>

  <!-- Local dev: use ConsoleEx project reference when available as sibling repo -->
  <ItemGroup Condition="Exists('../../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj')">
    <ProjectReference Include="../../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj" />
  </ItemGroup>
  <!-- CI/release: use NuGet package -->
  <ItemGroup Condition="!Exists('../../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj')">
    <PackageReference Include="SharpConsoleUI" Version="2.5.24" />
  </ItemGroup>

  <ItemGroup>
    <!-- SESSIONS, AGENTS AND THE TURN LOOP. Everything this app does to a conversation happens
         through CxAgent.Core; what stays here is the terminal — a window, a message loop, and the
         four commands that need one. Sqlite and AngleSharp come with it rather than being named
         here, because they are the library's dependencies and not the app's. -->
    <ProjectReference Include="../cxagent.Core/cxagent.Core.csproj" />
  </ItemGroup>

</Project>
