<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CxAgent</RootNamespace>
    <AssemblyName>cxagent</AssemblyName>
  </PropertyGroup>

  <!-- Local dev: use ConsoleEx project reference when available as sibling repo -->
  <ItemGroup Condition="Exists('../../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj')">
    <ProjectReference Include="../../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj" />
  </ItemGroup>
  <!-- CI/release: use NuGet package -->
  <ItemGroup Condition="!Exists('../../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj')">
    <PackageReference Include="SharpConsoleUI" Version="2.5.18" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />

    <!-- web_fetch: a real HTML parser rather than regex over a document. Both arrive transitively
         through SharpConsoleUI anyway; naming them here pins the versions we actually want and
         makes the dependency visible to anyone auditing it.

         1.5.0, not the 1.4.0 that comes in transitively: 1.4.0 carries GHSA-pgww-w46g-26qg, an mXSS
         sanitiser bypass. It does not reach us — we extract text and never re-serialize HTML into a
         browser — but taking the patched version costs nothing and stops the advisory showing up in
         every restore. -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>

</Project>
